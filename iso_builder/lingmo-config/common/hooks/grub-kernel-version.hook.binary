#!/bin/sh
# grub-pc/grub.cfg hardcodes /live/vmlinuz-6.12.12-amd64 (Lingmo's own kernel
# series), but the image ships the distribution kernel, so the GRUB entries
# pointed at files that do not exist and UEFI boots failed. Derive the version
# from the kernel actually installed in the chroot instead of guessing.
set -e

version="$(ls -1 chroot/boot/vmlinuz-* 2>/dev/null | head -1 | sed 's|.*/vmlinuz-||')"
if [ -z "$version" ]; then
    echo "grub-kernel-version: no kernel in chroot, leaving the templates alone"
    exit 0
fi
echo "grub-kernel-version: using $version"

for file in binary/boot/grub/grub.cfg binary/boot/grub/loopback.cfg; do
    [ -f "$file" ] || continue
    sed -i -E \
        -e "s|vmlinuz-[0-9][^ /]*|vmlinuz-${version}|g" \
        -e "s|initrd\.img-[0-9][^ /]*|initrd.img-${version}|g" \
        "$file"
    echo "grub-kernel-version: updated $file"
done
