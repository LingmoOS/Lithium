#!/bin/sh
# Keep the display manager usable: the Lingmo theme in this tree still uses
# Qt5 Controls 1 types (IconLabel), which SDDM's Qt6 build cannot load, so the
# Debian Breeze theme is selected instead. No autologin: the live system uses
# the default live user created by live-config.
set -e

rm -f /etc/sddm.conf
cat << 'CONF' > /etc/sddm.conf
[Theme]
Current=debian-breeze

[Users]
DefaultPath=/usr/bin:/bin

[General]
Numlock=on
CONF
